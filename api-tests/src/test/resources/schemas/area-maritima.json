{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Área marítima (AreaMaritimaExibicaoDto)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nome",
    "descricao",
    "localizacao",
    "nivelPoluicao",
    "dataCadastro"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": [
        "string",
        "null"
      ]
    },
    "localizacao": {
      "type": "string",
      "minLength": 1
    },
    "nivelPoluicao": {
      "type": "string",
      "minLength": 1
    },
    "dataCadastro": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
