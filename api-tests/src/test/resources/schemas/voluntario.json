{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Voluntário (VoluntarioExibicaoDto)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "nome",
    "email",
    "telefone",
    "especialidade",
    "dataCadastro"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "telefone": {
      "type": [
        "string",
        "null"
      ]
    },
    "especialidade": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataCadastro": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
