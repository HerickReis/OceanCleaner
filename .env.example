# Copie este arquivo para .env e preencha com seus valores:
#   cp .env.example .env
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

# Senha do administrador (SYS/SYSTEM) do container Oracle
ORACLE_PASSWORD=troque_esta_senha

# Usuário da aplicação (criado automaticamente no container Oracle)
DB_USERNAME=oceancleaner
DB_PASSWORD=troque_esta_senha

# Banco usado por operacoes-ms e voluntarios-ms
# Container local (padrão):
DB_URL=jdbc:oracle:thin:@oracle-db:1521/FREEPDB1
# Alternativa - Oracle da FIAP (exige DB_USERNAME/DB_PASSWORD do seu RM):
# DB_URL=jdbc:oracle:thin:@oracle.fiap.com.br:1521:ORCL

# Usuário/senha da API (Basic Auth) - exigido em POST/PUT/DELETE.
# Também usado pelo operacoes-ms para chamar o voluntarios-ms via Feign.
API_USER=admin
API_PASSWORD=troque_esta_senha
