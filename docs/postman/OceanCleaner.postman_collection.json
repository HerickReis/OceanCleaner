{
  "info": {
    "name": "Ocean Cleaner API",
    "description": "Testes de todos os endpoints do Ocean Cleaner, chamados pelo Gateway.\n\n**Como usar**\n1. Importe esta coleção e um dos arquivos de ambiente (local, staging ou produção).\n2. No ambiente, preencha `apiPassword` com o valor de `API_PASSWORD`.\n3. Execute a coleção inteira, na ordem, pelo *Collection Runner*: cada requisição guarda os IDs criados para as seguintes e a última pasta apaga os dados de teste.\n\nGET é público; POST, PUT e DELETE usam a autenticação Basic configurada na coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{apiUser}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{apiPassword}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Identificador da execução, para gerar e-mails únicos a cada rodada",
          "if (!pm.collectionVariables.get(\"runId\")) {",
          "  pm.collectionVariables.set(\"runId\", Date.now().toString());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "areaId",
      "value": ""
    },
    {
      "key": "voluntarioId",
      "value": ""
    },
    {
      "key": "operacaoId",
      "value": ""
    },
    {
      "key": "relatorioId",
      "value": ""
    },
    {
      "key": "relatorioExtraId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Saúde do ambiente",
      "description": "Confirma que o ambiente está no ar e qual versão está rodando.",
      "item": [
        {
          "name": "Info do ambiente (Gateway)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/info",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "info"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Informa ambiente e versão\", () => {",
                  "  const app = pm.response.json().app;",
                  "  pm.expect(app.environment).to.be.a(\"string\");",
                  "  pm.expect(app.version).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health (Gateway)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Status UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
                ]
              }
            }
          ]
        }
      ]
    },
