    {
      "name": "4. Conclusão e relatório (Feign)",
      "description": "Concluir uma operação faz o operacoes-ms chamar o voluntarios-ms e criar o relatório de coleta.",
      "item": [
        {
          "name": "Concluir sem dados de coleta (409)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
